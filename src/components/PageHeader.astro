---
import { SITE_NAME, pageHref } from '../lib/site';

interface Props {
  title: string;
  kind: string;
  nav: { href: string; label: string }[];
  navLabel: string;
}
const { title, kind, nav, navLabel } = Astro.props;
---
<header class="ph-head">
  <div class="wrap ph-top">
    <a class="back" href={pageHref()}>
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16 10H4"></path><path d="M9 5L4 10L9 15"></path></svg>
      All movements and words
    </a>
    <span class="ph-title">{title} <span class="ph-kind">{kind}</span></span>
    <a class="ph-site" href={pageHref()}>{SITE_NAME}</a>
  </div>
  <nav class="wrap secnav" aria-label={navLabel}>
    {nav.map((n, i) => <a href={n.href} data-label={n.label} aria-current={i === 0 ? 'true' : undefined}>{n.label}</a>)}
  </nav>
</header>
<script is:inline>
  // The orange underline follows the reader: it marks the section whose heading has last passed just under the
  // sticky menu, and the last section once the page is at its end. Runs after the page has loaded, so every
  // section exists (it used to run before them, found none and stopped).
  (function () {
    function init() {
      var nav = document.querySelector('.secnav');
      if (!nav) return;
      var head = document.querySelector('.ph-head');
      var pairs = Array.prototype.slice.call(nav.querySelectorAll('a'))
        .map(function (a) { return { a: a, t: document.getElementById(a.getAttribute('href').slice(1)) }; })
        .filter(function (p) { return p.t; });
      if (!pairs.length) return;
      var current = null, frame = 0;
      function update() {
        frame = 0;
        var line = (head ? head.getBoundingClientRect().bottom : 0) + 24;
        var pick = pairs[0];
        pairs.forEach(function (p) { if (p.t.getBoundingClientRect().top <= line) pick = p; });
        var root = document.documentElement;
        if (window.innerHeight + window.scrollY >= root.scrollHeight - 2) pick = pairs[pairs.length - 1];
        if (pick === current) return;
        current = pick;
        pairs.forEach(function (p) {
          if (p === pick) p.a.setAttribute('aria-current', 'true');
          else p.a.removeAttribute('aria-current');
        });
      }
      function soon() { if (!frame) frame = requestAnimationFrame(update); }
      window.addEventListener('scroll', soon, { passive: true });
      window.addEventListener('resize', soon);
      document.addEventListener('toggle', soon, true); // a history moment folding open moves what follows
      update();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
