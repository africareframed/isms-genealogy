---
import { SITE_NAME, pageHref } from '../lib/site';

interface Props {
  title: string;
  kind: 'Ism' | 'Theme';
  nav: { href: string; label: string }[];
  navLabel: string;
}
const { title, kind, nav, navLabel } = Astro.props;
---
<header class="ph-head">
  <div class="wrap ph-top">
    <a class="back" href={pageHref()}>
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16 10H4"></path><path d="M9 5L4 10L9 15"></path></svg>
      All isms and themes
    </a>
    <span class="ph-title">{title} <span class="ph-kind">{kind}</span></span>
    <a class="ph-site" href={pageHref()}>{SITE_NAME}</a>
  </div>
  <nav class="wrap secnav" aria-label={navLabel}>
    {nav.map((n, i) => <a href={n.href} aria-current={i === 0 ? 'true' : undefined}>{n.label}</a>)}
  </nav>
</header>
<script is:inline>
  (function () {
    var links = Array.prototype.slice.call(document.querySelectorAll('.secnav a'));
    var targets = links
      .map(function (a) { return document.getElementById(a.getAttribute('href').slice(1)); })
      .filter(Boolean);
    if (!('IntersectionObserver' in window) || !targets.length) return;
    var obs = new IntersectionObserver(
      function (items) {
        items.forEach(function (it) {
          if (!it.isIntersecting) return;
          links.forEach(function (a) {
            if (a.getAttribute('href') === '#' + it.target.id) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
          });
        });
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );
    targets.forEach(function (t) { obs.observe(t); });
  })();
</script>
