---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Picture from './Picture.astro';
import PageHeader from './PageHeader.astro';
import { FAMILIES, RELATIONS, SITE_NAME, eraOf, eraId, yearText, pageHref , strandsLine } from '../lib/site';
import { getHistory, momentAnchor } from '../lib/history';
import { namePattern, personAnchor } from '../lib/people';

const { ism } = Astro.props;
const { Content } = await render(ism);
const family = FAMILIES.find((f) => f.id === ism.data.family);
// The new page setup (owner, 25 Nov 2026): quote and lenses after the introduction, no "Who disputes it".
const L = ism.data.lenses;
// Can serve lists the same seven actor types in the same order on every page, so pages compare.
const andList = (xs: string[]) => (xs.length < 2 ? xs : [...xs.slice(0, -1).flatMap((x, i) => (i ? [', ', x] : [x])), ' and ', xs[xs.length - 1]]);
const STATUS = { gains: 'Gains', opponent: 'Gains · opponent', mixed: 'Mixed', loses: 'Loses', none: 'No mechanism' } as const;

const allThemes = await getCollection('themes');
const themeById = new Map(allThemes.map((t) => [t.id, t]));
// "Its words" (owner, 23 Nov 2026): one row of pills. A key word links to its own page; every other word
// links to its entry in the vocabulary. Then the other vocabulary words tagged with it, oldest first, and the key words it engages.
const vocab = await getCollection('words');
const wordByName = new Map(vocab.map((w) => [w.data.word.toLowerCase(), w]));
const themeByTitle = new Map(allThemes.map((t) => [t.data.title.toLowerCase(), t]));
const listed = new Set(ism.data.words.map((w) => w.toLowerCase()));
const wordPills = [
  ...ism.data.words.map((w) => {
    const t = themeByTitle.get(w.toLowerCase());
    if (t?.data.ready) return { label: w, href: pageHref(t.id) };
    const v = wordByName.get(w.toLowerCase());
    return { label: w, href: v ? `${pageHref('vocabulary')}#${v.id}` : undefined };
  }),
  // every other vocabulary word tagged with this movement (owner, 23 Nov 2026: all its words, in the vocabulary)
  ...vocab
    .filter((w) => w.data.isms.some((r) => r.id === ism.id) && !listed.has(w.data.word.toLowerCase()))
    .sort((x, y) => (x.data.year ?? 9999) - (y.data.year ?? 9999))
    .map((w) => ({ label: w.data.word, href: `${pageHref('vocabulary')}#${w.id}` })),
  ...ism.data.themes
    .map((r) => themeById.get(r.id))
    .filter((t) => t && !listed.has(t.data.title.toLowerCase()))
    .map((t) => ({ label: t!.data.title, href: t!.data.ready ? pageHref(t!.id) : undefined })),
];

const entries = (await getCollection('entries', (e) => e.data.ism.id === ism.id)).sort(
  (a, b) => b.data.year - a.data.year || (b.data.month ?? 0) - (a.data.month ?? 0),
);
const anchor = (id: string) => 'entry-' + id.split('/')[1];
const groups: { era: string; id: string; items: typeof entries }[] = [];
for (const e of entries) {
  const era = eraOf(e.data.year);
  let g = groups.find((x) => x.era === era);
  if (!g) groups.push((g = { era, id: eraId(era), items: [] }));
  g.items.push(e);
}

const yearOf = new Map(entries.map((e) => [e.id, e.data.year]));
const entryById = new Map(entries.map((e) => [e.id, e]));
const figures = (await getCollection('figures', (f) => f.data.isms.some((r) => r.id === ism.id))).sort(
  (a, b) => (yearOf.get(b.data.entry?.id ?? '') ?? 0) - (yearOf.get(a.data.entry?.id ?? '') ?? 0),
);

// Each notable figure links to their portrait on the People page (owner, 23 Nov 2026).
const people = await getCollection('people');
const personOf = (name: string) => {
  const n = name.replace(/\s*\(.*?\)\s*/g, ' ').trim();
  return people.find((p) => n.match(namePattern([p.data.name, ...p.data.aliases]))?.[0] === n);
};

// "In the history of AI" is built from the movement tags on history moments.
const inHistory = (await getHistory()).filter((m) => m.data.isms.some((r) => r.id === ism.id));
const arrow = `<svg aria-hidden="true" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10H16"></path><path d="M11 5L16 10L11 15"></path></svg>`;

const nav = [
  { href: '#introduction', label: 'Introduction' },
  ...groups.map((g) => ({ href: `#${g.id}`, label: g.era })),
];
const first = entries[0];
---
<Base title={`${ism.data.title} · ${SITE_NAME}`} description={ism.data.summary}>
  <PageHeader title={ism.data.title} kind="Movement" nav={nav} navLabel="Periods" />

  <main id="main">
    <section id="introduction" class="wrap intro">
      <div class="intro-text">
        <span class="kick">{family?.name} · Introduction</span>
        <h1>{ism.data.title}</h1>
        {(ism.data.aka || ism.data.includes.length > 0) && (
          <p class="inc" style="font-size: 14px; line-height: 20px; margin-top: -12px">{strandsLine(ism.data.aka, ism.data.includes)}</p>
        )}
        {ism.data.lead && <p class="lead">{ism.data.lead}</p>}
        <div class="body"><Content /></div>
        {L?.quote && (
          <figure class="iq">
            <blockquote><p>“{L.quote.text}”</p></blockquote>
            <figcaption class="cap">{L.quote.by}, {L.quote.url ? <a href={L.quote.url}>{L.quote.source}</a> : L.quote.source}</figcaption>
          </figure>
        )}
      </div>
      <Picture image={ism.data.pageImage ?? ism.data.image} ratio={ism.data.pageImage ? '4 / 5' : '4 / 3'} />
    </section>

    {L && (
      <section class="wrap sec argue" aria-label="Its values, fears, promises, funding and who it can serve" style={`--fam: ${family?.colour}`}>
        <div class="pair">
          <div class="pc">
            <p class="kick">Values</p>
            <p class="big">{andList(L.values).map((x, i) => (i % 2 === 0 ? <span class="mk">{x}</span> : x))}</p>
          </div>
          <div class="pc">
            <p class="kick">Fears</p>
            <p class="big">{andList(L.fears).map((x, i) => (i % 2 === 0 ? <span class="ul">{x}</span> : x))}</p>
          </div>
        </div>
        <div class="pair">
          <div class="pc">
            <p class="kick">Promises</p>
            <p class="mid">{L.promises}</p>
          </div>
          <div class="pc">
            <p class="kick">If it wins tomorrow</p>
            <p class="mid">{L.ifItWins}</p>
          </div>
        </div>
        <div class="pair">
          <div class="pc">
            <p class="kick">Funded by</p>
            <p class="big">{L.fundedBy}</p>
            {L.fundRows.map((r) => <p class="fr"><span class="fr-l">{r.label}</span> {r.text}</p>)}
          </div>
          <div class="pc">
            <p class="kick">Can serve</p>
            <ul class="cs">
              {L.canServe.map((c) => (
                <li class={c.status}>
                  <p class="cs-n"><span class={c.status === 'gains' || c.status === 'opponent' ? 'mk' : c.status === 'mixed' ? 'ul' : ''}>{c.actor}</span>{c.status !== 'gains' && <span class="cs-s">{STATUS[c.status].replace('Gains · ', '')}</span>}</p>
                  <p class="cs-t">{c.text}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
        {L.status === 'draft' && <p class="draft">Draft · to be checked</p>}
      </section>
    )}

    {ism.data.holders.length > 0 && (
      <section class="wrap sec" aria-labelledby="holders-h">
        <h2 class="kick" id="holders-h">Who holds it now</h2>
        <div class="actors">
          {ism.data.holders.map((h) => (
            <div><h3 class="an">{h.name}</h3><p class="ad">{h.note}</p></div>
          ))}
        </div>
      </section>
    )}

    {L && figures.length > 0 && (
      <section class="wrap sec" aria-labelledby="figures-h">
        <h2 class="kick" id="figures-h">People</h2>
        <ul class="pindex">
          {figures.map((f) => {
            const d = f.data;
            const e = d.entry ? entryById.get(d.entry.id) : undefined;
            const p = personOf(d.name);
            const inner = (
              <Fragment>
                {p?.data.portrait && <img src={`portraits/${p.data.portrait.file}`} alt="" width="36" height="36" loading="lazy" decoding="async" />}
                <span class="pi-n">{d.name}</span>
                {e && <span class="pi-y">{yearText(e.data.year, e.data.yearLabel)}</span>}
              </Fragment>
            );
            return <li>{p ? <a class="pi" href={`${pageHref('people')}#${personAnchor(p.id)}`}>{inner}</a> : <span class="pi">{inner}</span>}</li>;
          })}
        </ul>
      </section>
    )}

    {!L && figures.length > 0 && (
      <section class="wrap sec" aria-labelledby="figures-h">
        <h2 class="kick" id="figures-h">People</h2>
        <div class="names">
          {figures.map((f) => {
            const d = f.data;
            const e = d.entry ? entryById.get(d.entry.id) : undefined;
            return (
              <details class="nm">
                <summary>
                  <span class="nm-y">{e ? yearText(e.data.year, e.data.yearLabel) : ''}</span>
                  <span class="nm-n">{d.name}</span>
                  {d.lifespan && <span class="nm-l">{d.lifespan}</span>}
                </summary>
                <div class="nm-b">
                  <p>{d.note}</p>
                  {e && <a href={`#${anchor(e.id)}`}>In the history · {yearText(e.data.year, e.data.yearLabel)} · {e.data.title}</a>}
                  {personOf(d.name) && <a href={`${pageHref('people')}#${personAnchor(personOf(d.name)!.id)}`}>On the People page</a>}
                </div>
              </details>
            );
          })}
        </div>
      </section>
    )}

    {wordPills.length > 0 && (
      <section class="wrap sec" aria-labelledby="words-h">
        <h2 class="kick" id="words-h">Its words</h2>
        <p class="tchips lg">
          {wordPills.map((w) => (w.href ? <a href={w.href}>{w.label}</a> : <span class="off">{w.label}</span>))}
        </p>
      </section>
    )}

    {inHistory.length > 0 && (
      <section class="wrap sec" aria-labelledby="aih-h">
        <h2 class="kick" id="aih-h">In the history of AI</h2>
        <div>
          {inHistory.map((m) => (
            <a class="hist" href={`${pageHref('history')}#${momentAnchor(m.id)}`}>
              <span class="hy">{yearText(m.data.year, m.data.yearLabel)}</span>
              <span class="ht">{m.data.title}</span>
              <span class="hi">History of AI<Fragment set:html={arrow} /></span>
            </a>
          ))}
        </div>
      </section>
    )}

    {ism.data.disputes && !L && (
      <section class="wrap sec" aria-labelledby="disputes-h">
        <h2 class="kick" id="disputes-h">Who disputes it</h2>
        <p class="body" style="max-width: 900px">{ism.data.disputes}</p>
      </section>
    )}

    {first && (
      <a href={`#${groups[0].id}`} class="wrap nudge">
        <span class="nudge-t">Scroll back in time</span>
        <svg aria-hidden="true" width="28" height="44" viewBox="0 0 28 44" fill="none" stroke="#D8461C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2V40"></path><path d="M5 31L14 40L23 31"></path></svg>
        <span class="nudge-n">Next · {yearText(first.data.year, first.data.yearLabel)} · {first.data.title}</span>
      </a>
    )}

    <section class="wrap" aria-label="History">
      <div class="thread">
        {groups.map((g) => (
          <Fragment>
            <h2 id={g.id} class="era-h">{g.era}</h2>
            {g.items.map((e) => (
              <article class="item" id={anchor(e.id)}>
                <div class="meta">
                  <span class="yr">{yearText(e.data.year, e.data.yearLabel)}</span>
                  <span class="tag">{e.data.tagLabel ?? RELATIONS[e.data.relation]}</span>
                  {e.data.status === 'draft' && <span class="draft">Draft · to be checked</span>}
                </div>
                <div class="txt">
                  <h3 class="it">{e.data.title}</h3>
                  {e.data.who && <p class="who">{e.data.who}</p>}
                  <p class="ib">{e.data.text}</p>
                  <p class="src">{e.data.sourceUrl ? <a href={e.data.sourceUrl}>{e.data.source}</a> : e.data.source}</p>
                  {e.data.themes.length > 0 && (
                    <p class="tchips">
                      <span class="lbl">Vocabulary</span>
                      {e.data.themes.map((r) => {
                        const t = themeById.get(r.id);
                        return t?.data.ready ? <a href={pageHref(t.id)}>{t.data.title}</a> : <span class="off">{t?.data.title}</span>;
                      })}
                    </p>
                  )}
                </div>
                <Picture image={e.data.image} />
              </article>
            ))}
          </Fragment>
        ))}
      </div>
    </section>

    <section class="wrap end">
      <p>The oldest root traced so far.</p>
      <div class="end-links">
        <a href="#introduction">Back to the introduction</a>
        <a href={pageHref()}>All movements and words</a>
      </div>
    </section>
  </main>
</Base>
