---
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';
import { parse } from 'yaml';
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import { ERAS, FAMILIES, SITE_NAME, SITE_TITLE, MAP_DATE, pageHref, yearText } from '../lib/site';
import { getHistory } from '../lib/history';

const isms = (await getCollection('isms')).sort((a, b) => a.data.order - b.data.order);
const allThemes = (await getCollection('themes')).sort((a, b) => a.data.order - b.data.order);
const questions = allThemes;
const keyTitles = new Set(allThemes.map((t) => t.data.title.toLowerCase()));
// The vocabulary shows once src/data/words/words.yaml holds entries (an empty collection makes the build warn).
const hasWords = (parse(readFileSync('src/data/words/words.yaml', 'utf8')) ?? []).length > 0;
const words = hasWords ? (await getCollection('words')).sort((a, b) => (a.data.year ?? 0) - (b.data.year ?? 0)) : [];

const ismById = new Map(isms.map((i) => [i.id, i]));
const moments = await getHistory();
const historyEras = ERAS.filter((e) => moments.some((m) => m.data.era === e.id));
const oldest = moments[moments.length - 1];
const historyImage = (await getCollection('images')).find((i) => i.id === 'collage-history');
const num = (n: number) => String(n).padStart(2, '0');

---
<Base title={`${SITE_NAME}: ${SITE_TITLE}`}>
  <header class="wrap site-head">
    <a class="site-name" href={pageHref()}>{SITE_NAME}</a>
    <nav class="site-nav" aria-label="Site">
      <a href="#main">Movements</a>
      {moments.length > 0 && <a href={pageHref('history')}>History of AI</a>}
      <a href="#vocabulary">Vocabulary</a>
      <a href={pageHref('about')}>About</a>
      <a href={pageHref('method')}>Method</a>
    </nav>
  </header>

  <section class="wrap hero">
    <div class="hero-top">
      <p class="hk">{SITE_TITLE}</p>
      <p class="asof">Map as of {MAP_DATE}</p>
    </div>
    <div class="hero-grid">
      <h1><span>Transcend.</span> <span>Pause.</span> <span>Accelerate.</span></h1>
      <div class="hero-side">
        <p class="stand">ChatGPT arrived in November 2022 and felt like year zero. <span class="nb">It wasn't.</span></p>
        <div class="hero-body">
          <p>The AI world was already divided into camps, each with its own founding texts, institutions and language. Their arguments now shape what the labs build, what investors fund and what governments write into law.</p>
          <p>Many of their ideas are older than the computer. A rule for updating belief dates from 1763, a dream of perfecting humanity from 1795, a warning that machines would overtake us from 1863.</p>
          <p>Made Minds maps the <a href="#main">six movements</a>, the {moments.length > 0 ? <a href="#history">history of AI</a> : 'history of AI'} they grew out of, and the <a href="#vocabulary">vocabulary</a> they fight over.</p>
        </div>
      </div>
    </div>
  </section>

  <main id="main" class="wrap mov-sec" aria-labelledby="mov-h">
    <div class="themes-head">
      <h2 id="mov-h">Movements</h2>
    </div>
    <div class="fams">
      {FAMILIES.map((fam) => (
        <section class="fam" aria-labelledby={`fam-${fam.id}`}>
          <div class="fh">
            <h3 class="fn" id={`fam-${fam.id}`}><span class="fsw" style={`background:${fam.colour}`} aria-hidden="true"></span>{fam.name}</h3>
            <p class="fd">{fam.text}</p>
          </div>
          {isms
            .filter((i) => i.data.family === fam.id)
            .map((i) => {
              const inner = (
                <Fragment>
                  <Picture image={i.data.image} />
                  <span class="cn">{num(i.data.order)}</span>
                  <h4 class="ct">{i.data.title}</h4>
                  <p class="cd">{i.data.summary}</p>
                  {(i.data.aka || i.data.includes.length > 0) && (
                    <p class="inc">{[i.data.aka, i.data.includes.length ? `${i.data.aka ? "includes" : "Includes"} ${i.data.includes.join(', ').toLowerCase()}` : ''].filter(Boolean).join(' · ')}</p>
                  )}
                  {!i.data.ready && <span class="soon">In preparation</span>}
                </Fragment>
              );
              return i.data.ready ? <a class="card" href={pageHref(i.id)}>{inner}</a> : <div class="card">{inner}</div>;
            })}
        </section>
      ))}
    </div>
  </main>

  {moments.length > 0 && (
    <section id="history" class="wrap hist-sec" aria-labelledby="hist-h">
      <div class="themes-head">
        <h2 id="hist-h">History of AI</h2>
      </div>
      <a class="hcard" href={pageHref('history')}>
        {historyImage && <Picture image={{ collection: 'images', id: historyImage.id }} ratio="11 / 4" />}
        <div class="hc-side">
          <div class="hc-body">
            <p class="hc-t">From ancient automata to the generative race</p>
            <p class="hc-d">The machines, ideas, laboratories, money and laws that all six movements react to. {moments.length} moments, newest first, back to {yearText(oldest.data.year, oldest.data.yearLabel)}.</p>
          </div>
          <ol class="hc-eras">
            {historyEras.map((e) => <li><span class="s">{e.span}</span><span>{e.name}</span></li>)}
          </ol>
        </div>
      </a>
    </section>
  )}

  <section id="vocabulary" class="wrap themes-sec" aria-labelledby="vocab-h">
    <div class="themes-head">
      <h2 id="vocab-h">Vocabulary</h2>
    </div>
    <div class="tgrid">
      {questions.map((t) => {
        const inner = (
          <Fragment>
            <Picture image={t.data.image} ratio="3 / 2" />
            <h3 class="tt">{t.data.title}</h3>
            <p class="td">{t.data.summary}</p>
            {!t.data.ready && <span class="soon">In preparation</span>}
          </Fragment>
        );
        return t.data.ready ? <a class="card" href={pageHref(t.id)}>{inner}</a> : <div class="card">{inner}</div>;
      })}
    </div>
    {words.length > 0 && (
      <p class="vteaser">
        {words.filter((w) => !keyTitles.has(w.data.word.toLowerCase())).slice(-14).reverse().map((w) => <a href={`${pageHref('vocabulary')}#${w.id}`}>{w.data.word}</a>)}
        <a class="vall" href={pageHref('vocabulary')}>All {words.length} words →</a>
      </p>
    )}
  </section>

  <footer class="wrap site-foot">
    <span>{SITE_NAME} · A shared framework for how we speak about AI, and the history behind it</span>
    <nav aria-label="Footer">
      <a href={pageHref('about')}>About</a>
      <a href={pageHref('method')}>Method</a>
    </nav>
  </footer>
</Base>
