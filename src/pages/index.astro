---
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';
import { parse } from 'yaml';
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import { ERAS, FAMILIES, SITE_NAME, SITE_TITLE, MAP_DATE, pageHref, yearText, rightsLabel , strandsLine } from '../lib/site';
import { getHistory } from '../lib/history';

const isms = (await getCollection('isms')).sort((a, b) => a.data.order - b.data.order);
const allThemes = (await getCollection('themes')).sort((a, b) => a.data.order - b.data.order);
const questions = allThemes;
const keyTitles = new Set(allThemes.map((t) => t.data.title.toLowerCase()));
// The vocabulary shows once src/data/words/words.yaml holds entries (an empty collection makes the build warn).
const hasWords = (parse(readFileSync('src/data/words/words.yaml', 'utf8')) ?? []).length > 0;
const words = hasWords ? (await getCollection('words')).sort((a, b) => (a.data.year ?? 0) - (b.data.year ?? 0)) : [];

const ismById = new Map(isms.map((i) => [i.id, i]));
const moments = await getHistory();
const historyEras = ERAS.filter((e) => moments.some((m) => m.data.era === e.id));
const oldest = moments[moments.length - 1];
const historyImage = (await getCollection('images')).find((i) => i.id === 'collage-history');
// EXPERIMENT (21 Nov 2026): pieces of the card's second state (scripts/collages.py, collage-history-b) arrive
// on the collage's own 100 px grid, each at its own scroll position once the black square has clicked into place.
// Pieces are [column, row, width, height] in squares, in the order they arrive:
// Deep Blue over Kasparov's face, a grey slip beside the square, the man inside the Turk, an orange slip, Lee Sedol.
const GLITCH = {
  wide: { src: 'images/collage-history-b.jpg', cols: 22, rows: 10,
    pieces: [[9, 1, 4, 5], [7, 1, 1, 2], [3, 4, 2, 3], [14, 6, 1, 2], [18, 5, 2, 2]] },
  tall: { src: 'images/collage-history-tall-b.jpg', cols: 12, rows: 15,
    pieces: [[6, 1, 4, 5], [3, 0, 2, 1], [2, 2, 2, 2], [4, 11, 1, 2], [9, 12, 2, 2]] },
};
const num = (n: number) => String(n).padStart(2, '0');
// Parked (owner, 25 Nov 2026): the home page is an atlas of the movements only while the site is restructured.
// The History of AI card and its motion stay here, switched off; set to true to bring it back.
const SHOW_HISTORY_CARD = false;

---
<Base title={`${SITE_NAME}: ${SITE_TITLE}`}>
  <header class="wrap site-head">
    <a class="site-name" href={pageHref()}>{SITE_NAME}</a>
    <nav class="site-nav" aria-label="Site">
      {moments.length > 0 && <a href={pageHref('history')}>History of AI</a>}
      <a href="#movements">Movements</a>
      <a href={pageHref('people')}>People</a>
      <a href={pageHref('vocabulary')}>Vocabulary</a>
      <a href={pageHref('about')}>About</a>
      <a href={pageHref('method')}>Method</a>
    </nav>
  </header>

  <section class="wrap hero">
    <div class="hero-top">
      <p class="hk">{SITE_TITLE}</p>
      <p class="asof">Map as of {MAP_DATE}</p>
    </div>
    <div class="hero-grid">
      <h1><span>Transcend.</span> <span>Accelerate.</span> <span>Prevent.</span> <span>Protect.</span> <span>Reclaim.</span> <span>Doubt.</span></h1>
      <div class="hero-side">
        <p class="stand">ChatGPT felt like year zero.<br /><span class="nb">It wasn't.</span></p>
        <div class="hero-body">
          <p>The futures we argue about were imagined long ago: humans beyond biology, machines out of control, abundance for all, a world that barely changes.</p>
          <p>Today these ideas are movements, with founding texts, funders and institutions. They already shape what gets built, funded and made law, and so the world we will live in.</p>
          <p>This atlas maps twelve of them in six families, from the largest claims about what AI will make of us to the smallest. Each page traces its genealogy.</p>
        </div>
      </div>
    </div>
  </section>

  <main id="main">
  {SHOW_HISTORY_CARD && moments.length > 0 && (
    <section id="history" class="wrap hist-sec" aria-labelledby="hist-h">
      <div class="themes-head">
        <h2 id="hist-h">History of AI</h2>
      </div>
      <a class="hcard" href={pageHref('history')}>
        {historyImage && (
          <figure class="pic hpano" data-glitch={JSON.stringify(GLITCH)}>
            <div class="gl-frame">
              <picture>
                <source media="(max-width: 640px)" srcset="images/collage-history-tall-home.jpg" />
                <img src={`images/${historyImage.data.file}`} alt={historyImage.data.alt ?? ''} loading="lazy" decoding="async" />
              </picture>
              <span class="gl" aria-hidden="true"></span>
              <span class="gl-reg" aria-hidden="true"></span>
            </div>
            <figcaption class="cap">{historyImage.data.title} · {rightsLabel(historyImage.data.rights, historyImage.data.licence)}</figcaption>
          </figure>
        )}
        <div class="hc-side">
          <div class="hc-body">
            <p class="hc-t">From ancient automata to the generative race</p>
            <p class="hc-d">The machines, ideas, laboratories, money and laws that all twelve movements react to. {moments.length} moments, newest first, back to {yearText(oldest.data.year, oldest.data.yearLabel)}.</p>
          </div>
          <ol class="hc-eras">
            {historyEras.map((e) => <li><span class="s">{e.span}</span><span>{e.name}</span></li>)}
          </ol>
        </div>
      </a>
    </section>
  )}

  <section id="movements" class="wrap mov-sec" aria-labelledby="mov-h">
    <div class="themes-head">
      <h2 id="mov-h">Movements</h2>
      <p class="sec-intro">A movement here is a whole view of AI: what it is, where it is heading and what to do. Each was named by its own people, with founding texts, institutions and a vocabulary of its own. Six families, each named for what it wants done, run from the largest claims about what AI will become to the smallest.</p>
    </div>
    <div class="fams">
      {FAMILIES.map((fam) => (
        <section class="fam" aria-labelledby={`fam-${fam.id}`}>
          <div class="fh">
            <h3 class="fn" id={`fam-${fam.id}`}><span class="fsw" style={`background:${fam.colour}`} aria-hidden="true"></span>{fam.name}</h3>
            <p class="fd">{fam.text}</p>
          </div>
          {isms
            .filter((i) => i.data.family === fam.id)
            .map((i) => {
              const inner = (
                <Fragment>
                  <Picture image={i.data.image} />
                  <span class="cn">{num(i.data.order)}</span>
                  <h4 class="ct">{i.data.title}</h4>
                  <p class="cd">{i.data.summary}</p>
                  {(i.data.aka || i.data.includes.length > 0) && (
                    <p class="inc">{strandsLine(i.data.aka, i.data.includes)}</p>
                  )}
                  {!i.data.ready && <span class="soon">In preparation</span>}
                </Fragment>
              );
              return i.data.ready ? <a class="card" href={pageHref(i.id)}>{inner}</a> : <div class="card">{inner}</div>;
            })}
        </section>
      ))}
    </div>
  </section>

  </main>

  <footer class="wrap site-foot">
    <span>{SITE_NAME} · A shared framework for how we speak about AI, and the history behind it</span>
    <nav aria-label="Footer">
      <a href={pageHref('about')}>About</a>
      <a href={pageHref('method')}>Method</a>
    </nav>
  </footer>
  <script is:inline>
    // EXPERIMENT: the history card (owner, 21 Nov). The black square slides in smoothly as the reader scrolls, one way
    // only, from the moment the card enters the screen, and clicks into place once the whole card is in view. After that, each piece of the second state belongs to a
    // scroll position, close together, so a scroll brings them 1, 2, 3; scrolling back takes them away, last first.
    // A click anywhere on the card, pieces included, opens the history (owner). Nothing moves when the page is still.
    // Off for reduced motion.
    (() => {
      const fig = document.querySelector('[data-glitch]');
      if (!fig || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const cfg = JSON.parse(fig.dataset.glitch), img = fig.querySelector('img');
      const layer = fig.querySelector('.gl'), reg = fig.querySelector('.gl-reg'), ready = {};
      const fmt = () => ((img.currentSrc || img.src).includes('-tall') ? cfg.tall : cfg.wide);
      const load = (f) => {
        if (f.src in ready) return;
        ready[f.src] = false;
        const i = new Image();
        i.onload = () => { ready[f.src] = true; soon(); };
        i.src = f.src;
      };
      const GAP = 0.06; // the share of the screen's height the reader scrolls from one piece to the next
      let f = fmt(), els = [], least = 1, locked = false, frame = 0;
      const build = () => {
        layer.replaceChildren();
        els = f.pieces.map(([c, r, w, h]) => {
          const t = document.createElement('i'), st = t.style;
          st.left = (c / f.cols) * 100 + '%'; st.top = (r / f.rows) * 100 + '%';
          st.width = (w / f.cols) * 100 + '%'; st.height = (h / f.rows) * 100 + '%';
          st.backgroundImage = `url("${f.src}")`;
          st.backgroundSize = `${(f.cols / w) * 100}% ${(f.rows / h) * 100}%`;
          st.backgroundPosition = `${f.cols === w ? 0 : (c / (f.cols - w)) * 100}% ${f.rows === h ? 0 : (r / (f.rows - h)) * 100}%`;
          st.visibility = 'hidden';
          layer.appendChild(t);
          return t;
        });
      };
      const tick = () => {
        frame = 0;
        const b = fig.getBoundingClientRect();
        if (b.top < innerHeight + 800) load(f);
        // the square starts as the card's top edge enters the screen and locks once the whole card is in view
        if (!locked) {
          least = Math.min(least, Math.max(0, Math.min(1, (b.bottom - innerHeight) / b.height)));
          reg.style.transform = least ? `translateX(${(-least * 150).toFixed(2)}%)` : '';
          if (least) return;
          locked = true;
        }
        if (!ready[f.src]) return;
        if (!els.length) build();
        // all five pieces land while the whole card is still on screen: the gap fits the room the screen leaves
        const room = innerHeight - b.height, gap = Math.max(24, Math.min(innerHeight * GAP, (room * 0.75) / (els.length - 1)));
        const past = (innerHeight - b.bottom) / gap; // pieces' worth of scrolling past the click point
        els.forEach((t, k) => { t.style.visibility = past >= k ? 'visible' : 'hidden'; });
      };
      const soon = () => { if (!frame) frame = requestAnimationFrame(tick); };
      addEventListener('scroll', soon, { passive: true });
      addEventListener('resize', soon);
      // crossing 640 px swaps the wide card for the tall one: its own pieces take over
      img.addEventListener('load', () => {
        const g = fmt();
        if (g === f) return;
        f = g; els = [];
        layer.replaceChildren();
        load(f);
        soon();
      });
      tick();
    })();
  </script>
</Base>
