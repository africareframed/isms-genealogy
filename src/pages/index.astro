---
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';
import { parse } from 'yaml';
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import { ERAS, FAMILIES, SITE_NAME, SITE_TITLE, MAP_DATE, pageHref, yearText, rightsLabel } from '../lib/site';
import { getHistory } from '../lib/history';

const isms = (await getCollection('isms')).sort((a, b) => a.data.order - b.data.order);
const allThemes = (await getCollection('themes')).sort((a, b) => a.data.order - b.data.order);
const questions = allThemes;
const keyTitles = new Set(allThemes.map((t) => t.data.title.toLowerCase()));
// The vocabulary shows once src/data/words/words.yaml holds entries (an empty collection makes the build warn).
const hasWords = (parse(readFileSync('src/data/words/words.yaml', 'utf8')) ?? []).length > 0;
const words = hasWords ? (await getCollection('words')).sort((a, b) => (a.data.year ?? 0) - (b.data.year ?? 0)) : [];

const ismById = new Map(isms.map((i) => [i.id, i]));
const moments = await getHistory();
const historyEras = ERAS.filter((e) => moments.some((m) => m.data.era === e.id));
const oldest = moments[moments.length - 1];
const historyImage = (await getCollection('images')).find((i) => i.id === 'collage-history');
// EXPERIMENT (21 Nov 2026): the history card glitches. Squares of the card swap for the same squares of its
// second state (scripts/collages.py, collage-history-b), on the collage's own 100 px grid. Zones and reveals
// are in grid squares: [first column, last column, first row, last row] and [column, row, width, height].
const GLITCH = {
  // faces: [column, row, width, height] squares the glitch never touches (Kasparov's and Lee Sedol's heads)
  wide: { src: 'images/collage-history-b.jpg', cols: 22, rows: 10,
    zones: [[0, 6, 1, 8], [9, 13, 0, 8], [14, 21, 0, 8]], faces: [[10, 0, 3, 3], [16, 1, 4, 4]], reveals: [[2, 3, 3, 4], [2, 4, 3, 4]] },
  tall: { src: 'images/collage-history-tall-b.jpg', cols: 12, rows: 15,
    zones: [[0, 5, 0, 5], [6, 10, 0, 8], [4, 11, 9, 13]], faces: [[7, 0, 3, 4], [7, 9, 4, 3]], reveals: [[1, 1, 3, 4]] },
};
const num = (n: number) => String(n).padStart(2, '0');

---
<Base title={`${SITE_NAME}: ${SITE_TITLE}`}>
  <header class="wrap site-head">
    <a class="site-name" href={pageHref()}>{SITE_NAME}</a>
    <nav class="site-nav" aria-label="Site">
      <a href="#main">Movements</a>
      {moments.length > 0 && <a href={pageHref('history')}>History of AI</a>}
      <a href="#vocabulary">Vocabulary</a>
      <a href={pageHref('about')}>About</a>
      <a href={pageHref('method')}>Method</a>
    </nav>
  </header>

  <section class="wrap hero">
    <div class="hero-top">
      <p class="hk">{SITE_TITLE}</p>
      <p class="asof">Map as of {MAP_DATE}</p>
    </div>
    <div class="hero-grid">
      <h1><span>Transcend.</span> <span>Pause.</span> <span>Accelerate.</span></h1>
      <div class="hero-side">
        <p class="stand">ChatGPT arrived in November 2022 and felt like year zero.<br /><span class="nb">It wasn't.</span></p>
        <div class="hero-body">
          <p>The AI world was already divided into camps, each with its own founding texts, institutions and language. Their arguments now shape what the labs build, what investors fund and what governments write into law.</p>
          <p>Many of their ideas are older than the computer. A rule for updating belief dates from 1763, a dream of perfecting humanity from 1795, a warning that machines would overtake us from 1863.</p>
          <p>Made Minds maps the <a href="#main">six movements</a>, the {moments.length > 0 ? <a href="#history">history of AI</a> : 'history of AI'} they grew out of, and the <a href="#vocabulary">vocabulary</a> they fight over.</p>
        </div>
      </div>
    </div>
  </section>

  <main id="main" class="wrap mov-sec" aria-labelledby="mov-h">
    <div class="themes-head">
      <h2 id="mov-h">Movements</h2>
    </div>
    <div class="fams">
      {FAMILIES.map((fam) => (
        <section class="fam" aria-labelledby={`fam-${fam.id}`}>
          <div class="fh">
            <h3 class="fn" id={`fam-${fam.id}`}><span class="fsw" style={`background:${fam.colour}`} aria-hidden="true"></span>{fam.name}</h3>
            <p class="fd">{fam.text}</p>
          </div>
          {isms
            .filter((i) => i.data.family === fam.id)
            .map((i) => {
              const inner = (
                <Fragment>
                  <Picture image={i.data.image} />
                  <span class="cn">{num(i.data.order)}</span>
                  <h4 class="ct">{i.data.title}</h4>
                  <p class="cd">{i.data.summary}</p>
                  {(i.data.aka || i.data.includes.length > 0) && (
                    <p class="inc">{[i.data.aka, i.data.includes.length ? `${i.data.aka ? "includes" : "Includes"} ${i.data.includes.join(', ').toLowerCase()}` : ''].filter(Boolean).join(' · ')}</p>
                  )}
                  {!i.data.ready && <span class="soon">In preparation</span>}
                </Fragment>
              );
              return i.data.ready ? <a class="card" href={pageHref(i.id)}>{inner}</a> : <div class="card">{inner}</div>;
            })}
        </section>
      ))}
    </div>
  </main>

  {moments.length > 0 && (
    <section id="history" class="wrap hist-sec" aria-labelledby="hist-h">
      <div class="themes-head">
        <h2 id="hist-h">History of AI</h2>
      </div>
      <a class="hcard" href={pageHref('history')}>
        {historyImage && (
          <figure class="pic hpano" data-glitch={JSON.stringify(GLITCH)}>
            <div class="gl-frame">
              <picture>
                <source media="(max-width: 640px)" srcset="images/collage-history-tall-home.jpg" />
                <img src={`images/${historyImage.data.file}`} alt={historyImage.data.alt ?? ''} loading="lazy" decoding="async" />
              </picture>
              <span class="gl" aria-hidden="true"></span>
              <span class="gl-reg" aria-hidden="true"></span>
            </div>
            <figcaption class="cap">{historyImage.data.title} · {rightsLabel(historyImage.data.rights, historyImage.data.licence)}</figcaption>
          </figure>
        )}
        <div class="hc-side">
          <div class="hc-body">
            <p class="hc-t">From ancient automata to the generative race</p>
            <p class="hc-d">The machines, ideas, laboratories, money and laws that all six movements react to. {moments.length} moments, newest first, back to {yearText(oldest.data.year, oldest.data.yearLabel)}.</p>
          </div>
          <ol class="hc-eras">
            {historyEras.map((e) => <li><span class="s">{e.span}</span><span>{e.name}</span></li>)}
          </ol>
        </div>
      </a>
    </section>
  )}

  <section id="vocabulary" class="wrap themes-sec" aria-labelledby="vocab-h">
    <div class="themes-head">
      <h2 id="vocab-h">Vocabulary</h2>
    </div>
    <div class="tgrid">
      {questions.map((t) => {
        const inner = (
          <Fragment>
            <Picture image={t.data.image} ratio="3 / 2" />
            <h3 class="tt">{t.data.title}</h3>
            <p class="td">{t.data.summary}</p>
            {!t.data.ready && <span class="soon">In preparation</span>}
          </Fragment>
        );
        return t.data.ready ? <a class="card" href={pageHref(t.id)}>{inner}</a> : <div class="card">{inner}</div>;
      })}
    </div>
    {words.length > 0 && (
      <p class="vteaser">
        {words.filter((w) => !keyTitles.has(w.data.word.toLowerCase())).slice(-14).reverse().map((w) => <a href={`${pageHref('vocabulary')}#${w.id}`}>{w.data.word}</a>)}
        <a class="vall" href={pageHref('vocabulary')}>All {words.length} words →</a>
      </p>
    )}
  </section>

  <footer class="wrap site-foot">
    <span>{SITE_NAME} · A shared framework for how we speak about AI, and the history behind it</span>
    <nav aria-label="Footer">
      <a href={pageHref('about')}>About</a>
      <a href={pageHref('method')}>Method</a>
    </nav>
  </footer>
  <script is:inline>
    // EXPERIMENT: the history card's glitch. Mechanical, stepped, never smooth. Off for reduced motion.
    (() => {
      const fig = document.querySelector('[data-glitch]');
      if (!fig || !window.IntersectionObserver || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // The registration square moves like a ratchet, smoothly and with no glitch, so the reader sees the motion
      // is theirs: it creeps in from one and a half squares to the left as they scroll down, never moves back,
      // and locks onto the grid for good as the card reaches the middle of the screen (owner, 21 Nov).
      const reg = fig.querySelector('.gl-reg');
      let regFrame = 0, least = 1;
      const dial = () => {
        regFrame = 0;
        const b = fig.getBoundingClientRect(), mid = (b.top + b.bottom) / 2;
        least = Math.min(least, Math.max(0, Math.min(1, (mid - innerHeight / 2) / (innerHeight * 0.55))));
        reg.style.transform = least ? `translateX(${(-least * 150).toFixed(2)}%)` : '';
        if (!least) { removeEventListener('scroll', dialSoon); removeEventListener('resize', dialSoon); }
      };
      const dialSoon = () => { if (!regFrame) regFrame = requestAnimationFrame(dial); };
      addEventListener('scroll', dialSoon, { passive: true });
      addEventListener('resize', dialSoon);
      dial();
      const cfg = JSON.parse(fig.dataset.glitch), img = fig.querySelector('img'), layer = fig.querySelector('.gl');
      const PAPER = 'rgb(226, 223, 215)', state = {};
      let on = false;
      const rnd = (a, b) => a + Math.random() * (b - a);
      const pick = (a) => a[Math.floor(Math.random() * a.length)];
      const fmt = () => ((img.currentSrc || img.src).includes('-tall') ? cfg.tall : cfg.wide);
      const load = (f) => {
        if (state[f.src]) return;
        state[f.src] = 'loading';
        const i = new Image();
        i.onload = () => { state[f.src] = 'ready'; };
        i.src = f.src;
      };
      const tile = (f, c, r, w, h, mode) => {
        const t = document.createElement('i'), st = t.style;
        st.left = (c / f.cols) * 100 + '%'; st.top = (r / f.rows) * 100 + '%';
        st.width = (w / f.cols) * 100 + '%'; st.height = (h / f.rows) * 100 + '%';
        if (mode === 'blank') st.background = PAPER;
        else {
          // swap: the same squares of the second state; shift: this card's own squares, one column along
          const sc = mode === 'shift' ? Math.max(0, Math.min(f.cols - w, c + pick([-1, 1]))) : c;
          st.backgroundImage = `url("${mode === 'shift' ? img.currentSrc || img.src : f.src}")`;
          st.backgroundSize = `${(f.cols / w) * 100}% ${(f.rows / h) * 100}%`;
          st.backgroundPosition = `${f.cols === w ? 0 : (sc / (f.cols - w)) * 100}% ${f.rows === h ? 0 : (r / (f.rows - h)) * 100}%`;
        }
        st.visibility = 'hidden';
        layer.appendChild(t);
        return t;
      };
      // durations alternate shown, hidden, shown ... then the square is gone
      const flicker = (t, steps) => {
        let k = 0;
        const next = () => {
          if (k === steps.length) return t.remove();
          t.style.visibility = k % 2 ? 'hidden' : 'visible';
          setTimeout(next, steps[k++]);
        };
        next();
      };
      const burst = (big) => {
        const f = fmt();
        if (state[f.src] !== 'ready') return load(f);
        if (big) {
          const [c, r, w, h] = pick(f.reveals);
          return flicker(tile(f, c, r, w, h, 'swap'), [60, 50, rnd(650, 1100), 40, 70]);
        }
        // mostly one square, sometimes two side by side or one above the other; never on a face
        const hits = (c, r, w, h) => f.faces.some(([fc, fr, fw, fh]) => c < fc + fw && fc < c + w && r < fr + fh && fr < r + h);
        for (let tries = 0; tries < 12; tries++) {
          const [c0, c1, r0, r1] = pick(f.zones), s = Math.random();
          const w = s < 0.15 ? 2 : 1, h = s >= 0.15 && s < 0.3 ? 2 : 1;
          const c = c0 + Math.floor(Math.random() * (c1 - c0 + 2 - w));
          const r = r0 + Math.floor(Math.random() * (r1 - r0 + 2 - h));
          if (hits(c, r, w, h)) continue;
          const m = Math.random(), mode = m < 0.6 ? 'swap' : m < 0.85 ? 'shift' : 'blank';
          return flicker(tile(f, c, r, w, h, mode), pick([[90], [70, 50, 80], [110, 40, 60]]));
        }
      };
      // Driven by scroll (owner, 21 Nov): a few single squares as the reader scrolls past, one reveal of the
      // man hidden in the Turk as the card crosses the middle of the screen, still when the page is still.
      let lastY = scrollY, energy = 0, armed = true, frame = 0;
      const STEP = 320; // px of scroll per burst: four or five as the card goes by
      const onScroll = () => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const dy = Math.abs(scrollY - lastY);
          lastY = scrollY;
          if (!on) return;
          load(fmt());
          energy += Math.min(dy, 600);
          let n = 0;
          while (energy >= STEP && n < 1) { energy -= STEP; n++; setTimeout(() => burst(false), n * rnd(30, 90)); }
          const b = fig.getBoundingClientRect(), mid = (b.top + b.bottom) / 2, band = innerHeight * 0.18;
          if (Math.abs(mid - innerHeight / 2) < band) { if (armed) { armed = false; setTimeout(() => burst(true), 60); } }
          else armed = true;
        });
      };
      addEventListener('scroll', onScroll, { passive: true });
      new IntersectionObserver(([e]) => { on = e.isIntersecting; if (on) load(fmt()); }, { rootMargin: '800px 0px' }).observe(fig);
    })();
  </script>
</Base>
