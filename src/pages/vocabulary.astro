---
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';
import { parse } from 'yaml';
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import { FAMILIES, SITE_NAME, pageHref } from '../lib/site';
import { linkNames, personAnchor } from '../lib/people';

// The page fills once src/data/words/words.yaml holds entries (an empty collection makes the build warn).
const hasWords = (parse(readFileSync('src/data/words/words.yaml', 'utf8')) ?? []).length > 0;
const words = hasWords ? (await getCollection('words')).sort((a, b) => (a.data.year ?? 0) - (b.data.year ?? 0)) : [];
const isms = await getCollection('isms');
const people = (await getCollection('people')).map((p) => ({ id: p.id, name: p.data.name, aliases: p.data.aliases }));
const ismById = new Map(isms.map((i) => [i.id, i]));
const keyWords = new Map((await getCollection('themes')).map((t) => [t.data.title.toLowerCase(), t]));
// The key words with their cards, moved here from the home page (owner, 25 Nov 2026).
const themes = (await getCollection('themes')).sort((a, b) => a.data.order - b.data.order);
const familiesOf = (ids: string[]) => [...new Set(ids.map((id) => ismById.get(id)?.data.family).filter(Boolean))];

// The filter: CSS only, one radio per family, and one for the technical terms (owner, 21 Nov 2026).
const filterCss = [
  ...['all', ...FAMILIES.map((f) => f.id), 'tech'].map(
    (id) =>
      `#w-${id}:checked ~ .chips label[for="w-${id}"]{background:#111;border-color:#111;color:#fff}` +
      `#w-${id}:focus-visible ~ .chips label[for="w-${id}"]{outline:2px solid #D8461C;outline-offset:3px}`,
  ),
  ...FAMILIES.map((f) => `#w-${f.id}:checked ~ .wlist .word:not(.f-${f.id}){display:none}`),
  '#w-tech:checked ~ .wlist .word:not(.f-tech){display:none}',
].join('');
---
<Base title={`Vocabulary · ${SITE_NAME}`} description="The movements' own words, with who coined each one and when.">
  <Fragment set:html={`<style>${filterCss}</style>`} />
  <header class="wrap site-head">
    <a class="site-name" href={pageHref()}>{SITE_NAME}</a>
    <nav class="site-nav" aria-label="Site">
      <a href={pageHref()}>All movements</a>
    </nav>
  </header>

  <main id="main" class="wrap vocab">
    <h1>Vocabulary</h1>
    <p class="vlead">The words of the AI debate and its twelve movements, and the technical terms they argue over, oldest first, with who coined each one and when. Where an origin is disputed, the note says so.</p>

    <section class="vkeys" aria-labelledby="vk-h">
      <h2 id="vk-h" class="kick">Key words</h2>
      <div class="tgrid">
        {themes.map((t) => {
          const inner = (
            <Fragment>
              <Picture image={t.data.image} ratio="3 / 2" />
              <h3 class="tt">{t.data.title}</h3>
              <p class="td">{t.data.summary}</p>
              {!t.data.ready && <span class="soon">In preparation</span>}
            </Fragment>
          );
          return t.data.ready ? <a class="card" href={pageHref(t.id)}>{inner}</a> : <div class="card">{inner}</div>;
        })}
      </div>
    </section>

    <h2 class="kick vall-h">All words</h2>
    <input class="sr" type="radio" name="wf" id="w-all" checked aria-label="All words" />
    {FAMILIES.map((f) => <input class="sr" type="radio" name="wf" id={`w-${f.id}`} aria-label={`Words of ${f.name}`} />)}
    <input class="sr" type="radio" name="wf" id="w-tech" aria-label="Technical terms" />
    <div class="chips" role="group" aria-label="Show the words of one family, or the technical terms">
      <span class="lbl">Filter</span>
      <label for="w-all">All</label>
      {FAMILIES.map((f) => <label for={`w-${f.id}`}>{f.name}</label>)}
      <label for="w-tech">Technical terms</label>
    </div>

    <ul class="wlist">
      {words.map((w) => {
        const key = keyWords.get(w.data.word.toLowerCase());
        return (
          <li id={w.id} class={['word', ...familiesOf(w.data.isms.map((r) => r.id)).map((f) => `f-${f}`), ...(w.data.technical ? ['f-tech'] : [])].join(' ')}>
            <span class="wy">{w.data.yearLabel ?? w.data.year ?? ''}</span>
            <div>
              <h2 class="ww">{key?.data.ready ? <a href={pageHref(key.id)}>{w.data.word}</a> : w.data.word}</h2>
              <p class="wd">{w.data.definition}</p>
              <p class="wo">{w.data.coinedBy && <Fragment>{linkNames(w.data.coinedBy, people).map((x) => ("id" in x ? <a href={`${pageHref('people')}#${personAnchor(x.id)}`}>{x.text}</a> : x.text))} · </Fragment>}{w.data.origin}{w.data.sourceUrl && <Fragment> <a href={w.data.sourceUrl}>Source</a></Fragment>}</p>
              {w.data.isms.length > 0 && <p class="wi">{w.data.isms.map((r) => ismById.get(r.id)?.data.title).filter(Boolean).join(' · ')}</p>}
            </div>
          </li>
        );
      })}
    </ul>
  </main>

  <footer class="wrap site-foot">
    <span>{SITE_NAME} · An investigation into the ideas shaping AI, and the history behind them</span>
    <nav aria-label="Footer">
      <a href={pageHref('about')}>About</a>
      <a href={pageHref('method')}>Method</a>
    </nav>
  </footer>
</Base>
