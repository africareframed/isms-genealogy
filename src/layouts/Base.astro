---
import '../styles/site.css';
import { SITE_NAME, SITE_TITLE, SITE_URL } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  // the link preview's image, made by scripts/share-images.py (owner, 26 Nov 2026); the home page's by default
  share?: string;
}
const { title, description = `${SITE_TITLE}.`, share = 'images/share/home.jpg' } = Astro.props;
const pageUrl = SITE_URL + Astro.url.pathname.replace(/^\//, '').replace(/^index\.html$/, '');
const shareUrl = SITE_URL + share;
const latin =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const latinExt =
  'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const faces = [
  ['Inter Tight', 'inter-tight', [400, 500, 600]],
  ['IBM Plex Mono', 'ibm-plex-mono', [400, 500]],
] as const;
// The private preview artifact loads fonts from Google Fonts (its sandbox allows that);
// the real site serves its own copies from public/fonts.
const googleFonts = import.meta.env.PUBLIC_FONTS === 'google';
const fontCss = faces
  .flatMap(([family, file, weights]) =>
    weights.flatMap((w) => [
      `@font-face{font-family:'${family}';font-style:normal;font-weight:${w};font-display:swap;src:url(fonts/${file}-latin-ext-${w}-normal.woff2) format('woff2');unicode-range:${latinExt}}`,
      `@font-face{font-family:'${family}';font-style:normal;font-weight:${w};font-display:swap;src:url(fonts/${file}-latin-${w}-normal.woff2) format('woff2');unicode-range:${latin}}`,
    ]),
  )
  .join('\n');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareUrl} />
    {/* Kept out of search engines until the owner launches the site. */}
    <meta name="robots" content="noindex, nofollow" />
    {googleFonts ? (
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter+Tight:wght@400;500;600&display=swap" />
    ) : (
      <Fragment set:html={`<style>${fontCss}</style>`} />
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    {/* DEV ONLY (owner, 21 Nov 2026): a switch that shows the 12-column grid. Delete before launch. */}
    <div class="dev-grid" aria-hidden="true">
      <div class="wrap">{Array.from({ length: 12 }, () => <span></span>)}</div>
    </div>
    <button type="button" class="dev-grid-toggle" aria-pressed="false" title="Show the grid (G)">Grid</button>
    <script is:inline>
      (function () {
        var root = document.documentElement, btn = document.querySelector('.dev-grid-toggle');
        function set(on) {
          root.classList.toggle('show-grid', on);
          btn.setAttribute('aria-pressed', on ? 'true' : 'false');
          try { localStorage.setItem('mm-grid', on ? '1' : '0'); } catch (e) {}
        }
        var start = false;
        try { start = localStorage.getItem('mm-grid') === '1'; } catch (e) {}
        set(start);
        btn.addEventListener('click', function () { set(!root.classList.contains('show-grid')); });
        document.addEventListener('keydown', function (e) {
          var t = e.target && e.target.tagName;
          if ((e.key === 'g' || e.key === 'G') && !e.metaKey && !e.ctrlKey && !e.altKey && t !== 'INPUT' && t !== 'TEXTAREA') {
            set(!root.classList.contains('show-grid'));
          }
        });
      })();
    </script>
  </body>
</html>
